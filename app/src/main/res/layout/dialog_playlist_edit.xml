<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the "Edit playlist" dialog (PlaylistFragment.showEditDialog): tappable cover with an edit
     badge, then name and description fields. Everything is saved together with the Save button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <!-- Cover: tap to pick a picture; the round badge says it is editable -->
        <FrameLayout
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/editCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edit_cover_bg"
                android:clickable="true"
                android:contentDescription="@string/playlist_cover"
                android:focusable="true"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/editCoverBadge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/edit_badge_bg"
                android:contentDescription="@string/playlist_cover_choose"
                android:padding="10dp"
                android:src="@drawable/ic_edit"
                android:tint="?attr/colorOnAccent" />
        </FrameLayout>

        <!-- Only shown while the list has a cover picture -->
        <TextView
            android:id="@+id/editCoverRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/playlist_cover_remove"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/playlist_name_hint"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_bg"
            android:hint="@string/playlist_name_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorTextPrimary"
            android:textColorHint="?attr/colorTextSecondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/playlist_desc_hint"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_bg"
            android:gravity="top|start"
            android:hint="@string/playlist_desc_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="?attr/colorTextPrimary"
            android:textColorHint="?attr/colorTextSecondary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
