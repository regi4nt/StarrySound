<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row: tap to choose the streaming audio quality. Add inside Settings > Online music,
     then in code: StreamQuality.summary(ctx) -> audioQualityValue.text, and
     row.setOnClickListener { StreamQuality.showDialog(ctx) { audioQualityValue.text = StreamQuality.summary(ctx) } } -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/audioQualityRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audio_quality_title"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audio_quality_row_desc"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/audioQualityValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/colorAccent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
