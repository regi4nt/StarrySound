<?xml version="1.0" encoding="utf-8"?>
<!-- First row of an opened playlist's song list, Spotify style: big centred cover, then description and
     length. It scrolls away with the songs (PlaylistFragment: ConcatAdapter(HeaderAdapter, trackAdapter)). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/plCover"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/art_bg"
        android:clipToOutline="true"
        android:contentDescription="@string/playlist_cover"
        android:elevation="12dp"
        android:outlineProvider="background"
        android:padding="64dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_playlist"
        android:tint="?attr/colorTextSecondary" />

    <TextView
        android:id="@+id/plDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/plMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="12sp" />

    <!-- Shown instead of the song rows when the list has none to show. -->
    <TextView
        android:id="@+id/plHeaderEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
