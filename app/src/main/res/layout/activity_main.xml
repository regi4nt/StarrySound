<?xml version="1.0" encoding="utf-8"?>
<!-- Hosts the swipeable Home / Quick / Search / Playlist / Screensaver pages plus a bottom nav bar
     that does the same job as swiping, for anyone who'd rather tap. See
     MainActivity + HomeFragment / ScreensaverFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBg">

    <!-- Pager + mini player share one frame: the mini player floats over the page, so the strip around its
         rounded bar is transparent (the page shows through) instead of an app-theme coloured box. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mainPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Compact now-playing bar above the nav (no card behind it): art, title/artist, play/pause, next, thin progress.
         Hidden until something is queued. Wired up in MainActivity.setupMiniPlayer(). -->
    <FrameLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/miniArt"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/mini_art_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/miniAddPlaylist"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/np_add_playlist"
                android:padding="8dp"
                android:src="@drawable/ic_playlist_add"
                android:tint="?attr/colorTextSecondary" />

            <ImageButton
                android:id="@+id/miniPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_play_pause"
                android:src="@drawable/ic_play"
                android:tint="?attr/colorTextPrimary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/miniProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:max="1000"
            android:progressTint="?attr/colorTextPrimary"
            android:progressBackgroundTint="?attr/colorTrackBg" />
    </FrameLayout>
    </FrameLayout>

    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorDivider" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHomeTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_home_label"
                android:src="@drawable/ic_home"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home_label"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMusicTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navMusicIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_music_label"
                android:src="@drawable/ic_music"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/navMusicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_music_label"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlaylistTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navPlaylistIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_playlist_label"
                android:src="@drawable/ic_playlist"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/navPlaylistLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_playlist_label"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navQuickTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navQuickIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_quick_label"
                android:src="@drawable/ic_quick"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/navQuickLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_quick_label"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navScreensaverTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navScreensaverIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_screensaver_label"
                android:src="@drawable/ic_screensaver"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/navScreensaverLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_screensaver_label"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
