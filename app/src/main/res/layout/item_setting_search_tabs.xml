<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row: tap to choose the online tabs shown in Search. Add inside Settings > Online music,
     then in code: SearchTabs.summary(ctx) -> searchTabsValue.text, and
     row.setOnClickListener { SearchTabs.showDialog(ctx) { searchTabsValue.text = SearchTabs.summary(ctx) } } -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchTabsRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_tabs_title"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_tabs_desc"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:alpha="0.7" />

    <TextView
        android:id="@+id/searchTabsValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceLabelLarge" />
</LinearLayout>
