<?xml version="1.0" encoding="utf-8"?>
<!-- Page 1 of MainActivity's pager: local music library + player controls. See MusicFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <!-- Header row: "Musik" title + count on the left, Data saver logo toggle
             on the right, vertically centred against the title block. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/music_title"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Data used while Data saver is on (hidden otherwise); tap to start again from 0. -->
            <TextView
                android:id="@+id/dataUsedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:textColor="?attr/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/saverButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/saver_switch_label"
                android:padding="10dp"
                android:src="@drawable/ic_data_saver"
                android:tint="?attr/colorTextSecondary" />

            <!-- Audio / video mode: Device and YouTube results open as video while on (MusicPrefs.videoMode).
                 Private mode now lives in Settings. -->
            <ImageButton
                android:id="@+id/videoModeButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_mode_desc"
                android:padding="10dp"
                android:src="@drawable/ic_music"
                android:tint="?attr/colorTextSecondary" />
        </LinearLayout>

        <!-- Where the music comes from. Online tabs search with the API key / login set in Settings. -->
        <LinearLayout
            android:id="@+id/sourceTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabLocal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="9dp"
                android:text="@string/source_local"
                android:textColor="@color/chip_text_color"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabYoutube"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="9dp"
                android:text="@string/source_youtube"
                android:textColor="@color/chip_text_color"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="9dp"
                android:text="@string/source_tv"
                android:textColor="@color/chip_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tabRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="9dp"
                android:text="@string/source_radio"
                android:textColor="@color/chip_text_color"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabOnline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="9dp"
                android:text="@string/source_online"
                android:textColor="@color/chip_text_color"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Radio tab only: which directory the stations come from. -->
        <TextView
            android:id="@+id/radioSourceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/chip_text_color"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Online tab only: source + options, styled like the Radio source chip. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="@string/music_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextSecondary"
                android:textSize="14sp" />

            <!-- Device, YouTube and Radio tabs: filter (source / length / artist, or country / genre). -->
            <ImageButton
                android:id="@+id/filterButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/filter_title"
                android:padding="10dp"
                android:src="@drawable/ic_filter"
                android:tint="?attr/colorTextSecondary"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trackList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="74dp" />

        <ProgressBar
            android:id="@+id/searchProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorAccent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/actionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/eq_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="26dp"
                android:paddingVertical="10dp"
                android:text="@string/music_allow_access"
                android:textColor="?attr/colorOnAccent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Player bar: superseded by the mini player + full-screen NowPlayingActivity; kept (gone) so
         MusicFragment's view references stay valid. -->
    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/nowArt"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/art_bg"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music"
                android:tint="?attr/colorTextSecondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/music_nothing_playing"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nowArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <SeekBar
            android:id="@+id/progressSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/timeElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0:00"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="11sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/shuffleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_shuffle"
                android:padding="12dp"
                android:src="@drawable/ic_shuffle"
                android:tint="?attr/colorTextSecondary" />

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_previous"
                android:padding="12dp"
                android:src="@drawable/ic_prev"
                android:tint="?attr/colorTextPrimary" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/eq_button_bg"
                android:contentDescription="@string/music_play_pause"
                android:padding="16dp"
                android:src="@drawable/ic_play"
                android:tint="?attr/colorOnAccent" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_next"
                android:padding="12dp"
                android:src="@drawable/ic_next"
                android:tint="?attr/colorTextPrimary" />

            <ImageButton
                android:id="@+id/repeatButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_repeat"
                android:padding="12dp"
                android:src="@drawable/ic_repeat"
                android:tint="?attr/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
