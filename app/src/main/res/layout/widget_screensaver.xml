<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver widget, 1 cell x 1 cell: a round blue-violet button on the card. Tap = open the
     Screensaver page. RemoteViews-safe views and literal colors only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screensaverWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_open_screensaver">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_screensaver"
        android:background="@drawable/widget_power_bg_on"
        android:importantForAccessibility="no" />
</LinearLayout>
