<?xml version="1.0" encoding="utf-8"?>
<!-- Video player, laid out like the music player (NowPlayingActivity): video where the cover is, then title, artist,
     seek bar and the round play button. In landscape only the video and a compact control strip are shown.
     See VideoPlayerActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBg"
    android:orientation="vertical">

    <!-- Top bar: collapse (same arrow as the music player). -->
    <RelativeLayout
        android:id="@+id/vpHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/vpClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/np_close"
            android:rotation="-90"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/colorTextPrimary" />
    </RelativeLayout>

    <!-- The video. Its size (16:9) is set in code for the current orientation. -->
    <FrameLayout
        android:id="@+id/vpVideoFrame"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/vpInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/vpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vpArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vpPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <SeekBar
            android:id="@+id/vpSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/vpElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/vpTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0:00"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="12sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/vpPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_previous"
                android:padding="10dp"
                android:src="@drawable/ic_prev"
                android:tint="?attr/colorTextPrimary" />

            <TextView
                android:id="@+id/vpBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="-10"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/vpPlay"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/eq_button_bg"
                android:contentDescription="@string/music_play_pause"
                android:padding="18dp"
                android:src="@drawable/ic_pause"
                android:tint="?attr/colorOnAccent" />

            <TextView
                android:id="@+id/vpForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="+10"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/vpNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_next"
                android:padding="10dp"
                android:src="@drawable/ic_next"
                android:tint="?attr/colorTextPrimary" />

            <ImageButton
                android:id="@+id/vpRotate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_rotate"
                android:padding="10dp"
                android:src="@drawable/ic_screen_rotation"
                android:tint="?attr/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
