<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver shortcut widget: fixed 1 x 1 cell (40dp = 1 cell, "70*cells - 30" dp). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_screensaver"
    android:previewImage="@drawable/widget_preview_screensaver"
    android:previewLayout="@layout/widget_screensaver"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_screensaver_description" />
