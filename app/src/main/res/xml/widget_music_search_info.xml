<?xml version="1.0" encoding="utf-8"?>
<!--
    Music-search widget: ONE cell tall (resizable horizontally only), a search pill that opens the
    app's Music page with the search box focused, plus a Detect song button (see MusicSearchWidgetProvider). Nothing here changes at
    runtime, so updatePeriodMillis is 0.
    Cell math is "70*cells - 30" dp: 40dp = 1 cell, 250dp = 4 cells.
        1 cell   -> widget_music_search_mini    (search button only)
        2 cells  -> widget_music_search_duo     (search + detect song buttons)
        3 cells  -> widget_music_search_compact (search icon pill + detect button)
        4+ cells -> widget_music_search         (search pill with hint + detect button)
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_music_search"
    android:previewLayout="@layout/widget_music_search"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_music_search_description" />
