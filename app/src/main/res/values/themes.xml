<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default (day/light) values. android:theme's DayNight parent swaps
         this out for values-night/themes.xml automatically based on
         AppCompatDelegate's night mode — see ThemeHelper.applyMode(). -->
    <style name="Theme.FXSoundLite" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/WindowAnim.Fade</item>
        <item name="colorPrimary">@color/accent_default</item>
        <item name="colorPrimaryDark">@color/light_bg</item>
        <item name="colorAccent">@color/accent_default</item>
        <item name="android:windowBackground">?attr/colorBg</item>

        <item name="colorBg">@color/light_bg</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorSurfaceRaised">@color/light_surface_raised</item>
        <item name="colorTextPrimary">@color/light_text_primary</item>
        <item name="colorTextSecondary">@color/light_text_secondary</item>
        <item name="colorDivider">@color/light_divider</item>
        <item name="colorTrackBg">@color/light_track_bg</item>
        <item name="colorDanger">@color/danger</item>
        <item name="colorHeaderIcon">?attr/colorTextSecondary</item>
        <item name="colorOnAccent">@color/light_on_accent</item>
    </style>

    <!-- Accent sub-theme overlays: applied on top of Theme.FXSoundLite at
         runtime (ThemeHelper.applyAccent) to repaint colorAccent/colorPrimary
         without needing a light x dark x color matrix of concrete themes.
         parent="" is required here: AAPT infers an implicit parent from a
         dotted style name (stripping the last segment), so without it the
         build would look for a nonexistent "ThemeOverlay.Accent" style and
         fail to link. Only Default overrides colorOnAccent — its fill flips
         between black/white per mode, so the text/icon drawn on top must
         flip with it. The other six are bright/saturated in both modes, so
         they keep inheriting the base theme's dark colorOnAccent unchanged. -->
    <style name="ThemeOverlay.Accent.Default" parent="">
        <item name="colorAccent">@color/accent_default</item>
        <item name="colorPrimary">@color/accent_default</item>
        <item name="colorOnAccent">@color/accent_default_on</item>
    </style>
    <style name="ThemeOverlay.Accent.Red" parent="">
        <item name="colorAccent">@color/accent_red</item>
        <item name="colorPrimary">@color/accent_red</item>
    </style>
    <style name="ThemeOverlay.Accent.Yellow" parent="">
        <item name="colorAccent">@color/accent_yellow</item>
        <item name="colorPrimary">@color/accent_yellow</item>
    </style>
    <style name="ThemeOverlay.Accent.Blue" parent="">
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorPrimary">@color/accent_blue</item>
    </style>
    <style name="ThemeOverlay.Accent.Orange" parent="">
        <item name="colorAccent">@color/accent_orange</item>
        <item name="colorPrimary">@color/accent_orange</item>
    </style>
    <style name="ThemeOverlay.Accent.Green" parent="">
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorPrimary">@color/accent_green</item>
    </style>
    <style name="ThemeOverlay.Accent.Purple" parent="">
        <item name="colorAccent">@color/accent_purple</item>
        <item name="colorPrimary">@color/accent_purple</item>
    </style>

    <!-- Small white caption under each Quick-tab action button. -->
    <style name="QuickActionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <!-- Simple cross-fade between screens (no sideways sliding). Screens that slide up like the player set their own. -->
    <style name="WindowAnim.Fade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:taskOpenExitAnimation">@anim/fade_out</item>
        <item name="android:taskCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:taskCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Scene themes: whole-app palette + matching accent, one per animated Screensaver background. -->
    <style name="ThemeOverlay.Scene.Rain" parent="">
        <item name="colorBg">@color/scene_rain_bg</item>
        <item name="android:windowBackground">@color/scene_rain_bg</item>
        <item name="colorPrimaryDark">@color/scene_rain_bg</item>
        <item name="colorSurface">@color/scene_rain_surface</item>
        <item name="colorSurfaceRaised">@color/scene_rain_raised</item>
        <item name="colorTextPrimary">@color/scene_rain_text</item>
        <item name="colorTextSecondary">@color/scene_rain_text2</item>
        <item name="colorDivider">@color/scene_rain_divider</item>
        <item name="colorTrackBg">@color/scene_rain_track</item>
        <item name="colorAccent">@color/scene_rain_accent</item>
        <item name="colorPrimary">@color/scene_rain_accent</item>
        <item name="colorOnAccent">@color/scene_rain_on</item>
    </style>
    <style name="ThemeOverlay.Scene.Nightsky" parent="">
        <item name="colorBg">@color/scene_nightsky_bg</item>
        <item name="android:windowBackground">@color/scene_nightsky_bg</item>
        <item name="colorPrimaryDark">@color/scene_nightsky_bg</item>
        <item name="colorSurface">@color/scene_nightsky_surface</item>
        <item name="colorSurfaceRaised">@color/scene_nightsky_raised</item>
        <item name="colorTextPrimary">@color/scene_nightsky_text</item>
        <item name="colorTextSecondary">@color/scene_nightsky_text2</item>
        <item name="colorDivider">@color/scene_nightsky_divider</item>
        <item name="colorTrackBg">@color/scene_nightsky_track</item>
        <item name="colorAccent">@color/scene_nightsky_accent</item>
        <item name="colorPrimary">@color/scene_nightsky_accent</item>
        <item name="colorOnAccent">@color/scene_nightsky_on</item>
    </style>
    <style name="ThemeOverlay.Scene.Starfield" parent="">
        <item name="colorBg">@color/scene_starfield_bg</item>
        <item name="android:windowBackground">@color/scene_starfield_bg</item>
        <item name="colorPrimaryDark">@color/scene_starfield_bg</item>
        <item name="colorSurface">@color/scene_starfield_surface</item>
        <item name="colorSurfaceRaised">@color/scene_starfield_raised</item>
        <item name="colorTextPrimary">@color/scene_starfield_text</item>
        <item name="colorTextSecondary">@color/scene_starfield_text2</item>
        <item name="colorDivider">@color/scene_starfield_divider</item>
        <item name="colorTrackBg">@color/scene_starfield_track</item>
        <item name="colorAccent">@color/scene_starfield_accent</item>
        <item name="colorPrimary">@color/scene_starfield_accent</item>
        <item name="colorOnAccent">@color/scene_starfield_on</item>
    </style>
    <style name="ThemeOverlay.Scene.Water" parent="">
        <item name="colorBg">@color/scene_water_bg</item>
        <item name="android:windowBackground">@color/scene_water_bg</item>
        <item name="colorPrimaryDark">@color/scene_water_bg</item>
        <item name="colorSurface">@color/scene_water_surface</item>
        <item name="colorSurfaceRaised">@color/scene_water_raised</item>
        <item name="colorTextPrimary">@color/scene_water_text</item>
        <item name="colorTextSecondary">@color/scene_water_text2</item>
        <item name="colorDivider">@color/scene_water_divider</item>
        <item name="colorTrackBg">@color/scene_water_track</item>
        <item name="colorAccent">@color/scene_water_accent</item>
        <item name="colorPrimary">@color/scene_water_accent</item>
        <item name="colorOnAccent">@color/scene_water_on</item>
    </style>
    <style name="ThemeOverlay.Accent.SceneRain" parent="">
        <item name="colorAccent">@color/scene_rain_accent</item>
        <item name="colorPrimary">@color/scene_rain_accent</item>
        <item name="colorOnAccent">@color/scene_rain_on</item>
    </style>
    <style name="ThemeOverlay.Accent.SceneNightsky" parent="">
        <item name="colorAccent">@color/scene_nightsky_accent</item>
        <item name="colorPrimary">@color/scene_nightsky_accent</item>
        <item name="colorOnAccent">@color/scene_nightsky_on</item>
    </style>
    <style name="ThemeOverlay.Accent.SceneStarfield" parent="">
        <item name="colorAccent">@color/scene_starfield_accent</item>
        <item name="colorPrimary">@color/scene_starfield_accent</item>
        <item name="colorOnAccent">@color/scene_starfield_on</item>
    </style>
    <style name="ThemeOverlay.Accent.SceneWater" parent="">
        <item name="colorAccent">@color/scene_water_accent</item>
        <item name="colorPrimary">@color/scene_water_accent</item>
        <item name="colorOnAccent">@color/scene_water_on</item>
    </style>

    <!-- Launch screen: dark background + the app logo (instead of the white window before the app shows).
         MainActivity switches to Theme.FXSoundLite as soon as it is ready (installSplashScreen). -->
    <style name="Theme.FXSoundLite.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.FXSoundLite</item>
    </style>
</resources>
