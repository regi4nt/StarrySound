<?xml version="1.0" encoding="utf-8"?>
<!-- The whole logo (S + treble clef + star on the night sky) is one painted image,
     so it lives in the background layer; the foreground is intentionally empty.
     The art keeps the logo inside the 66dp adaptive-icon safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@android:color/transparent"/>
</adaptive-icon>
