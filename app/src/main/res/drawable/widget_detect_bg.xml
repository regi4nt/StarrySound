<?xml version="1.0" encoding="utf-8"?>
<!-- "Detect song" button of the music-search widget: blue-to-violet pill. Literal colors only (RemoteViews). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF4FA3FF" android:endColor="#FF7B5CFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
