<?xml version="1.0" encoding="utf-8"?>
<!-- Power button, ON: bright blue-to-violet disc with a soft light ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FF4FA3FF" android:endColor="#FF7B5CFF" />
        </shape>
    </item>
    <item><shape android:shape="oval"><stroke android:width="1.5dp" android:color="#B3FFFFFF" /></shape></item>
</layer-list>
