<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: deep navy, almost opaque, with a thin rim and a faint inner highlight along the top.
     Literal colors only (RemoteViews are inflated in the launcher process, ?attr would not resolve). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F2171C30" android:endColor="#F20D1019" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
