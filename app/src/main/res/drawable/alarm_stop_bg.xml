<?xml version="1.0" encoding="utf-8"?>
<!-- Stop button of the ringing alarm. Fixed white fill + black text: the alarm screen always sits on the
     dark Screensaver background, and the theme accent (white in dark mode) made the old white-on-accent label invisible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFD9D9D9" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</selector>
